{
  "name": "dsh-fairy-visual",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-settings": "0.1.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.1"
  },
  "devDependencies": {
    "tsdown": "^0.22.14"
  },
  "scripts": {
    "bundle": "tsdown && cp lib/index.iife.js lib/client.js.tmp && mv -f lib/client.js.tmp lib/client.js && cp src/index.js lib/index.js.tmp && mv -f lib/index.js.tmp lib/index.js",
    "test": "node --test test/*.test.js",
    "verify:build": "node ../../fairy-system/verify-build.js",
    "watch": "tsdown --watch"
  }
}
